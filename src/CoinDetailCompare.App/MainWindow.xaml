<Window x:Class="CoinDetailCompare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoinDetailCompare"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FF2B2E33" Padding="10,6">
            <TextBlock Text="{Binding Status}" Foreground="#FFF0F0F0" />
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left: Capture ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Съёмка" />

                    <TextBlock Text="Альбом" Margin="0,6,0,2" />
                    <TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Страница" />
                            <TextBox Text="{Binding PageNo}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Порядок" />
                            <TextBox Text="{Binding OrderNo}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Угол (°)" />
                            <TextBox Text="{Binding Rotation}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10" />
                    <Button Style="{StaticResource Btn}" Content="Снять аверс"
                            Command="{Binding ShootObverseCommand}" />
                    <Button Style="{StaticResource Btn}" Content="Снять реверс"
                            Command="{Binding ShootReverseCommand}" />
                    <Button Style="{StaticResource Btn}" Content="Загрузить аверс (файл)"
                            Command="{Binding LoadObverseFileCommand}" />
                    <Button Style="{StaticResource Btn}" Content="Загрузить реверс (файл)"
                            Command="{Binding LoadReverseFileCommand}" />
                    <Button Style="{StaticResource Btn}" Content="Поменять аверс/реверс"
                            Command="{Binding SwapSidesCommand}" />

                    <Separator Margin="0,10" />
                    <TextBlock Style="{StaticResource Title}" Text="Пакетный режим" />
                    <TextBlock Text="Альбом" Margin="0,4,0,2" />
                    <TextBox Text="{Binding BatchAlbum, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Страница" />
                            <TextBox Text="{Binding BatchPage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Кол-во монет" />
                            <TextBox Text="{Binding BatchCount}" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource Btn}" Content="Открыть камеру"
                            Command="{Binding OpenCameraCommand}" />
                    <Button Style="{StaticResource Btn}" Content="Старт пакетной съёмки"
                            Command="{Binding StartBatchCommand}"
                            IsEnabled="{Binding BatchActive, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource Btn}" Content="Сделать кадр"
                            Command="{Binding CaptureNextCommand}"
                            IsEnabled="{Binding BatchActive}" />
                    <Button Style="{StaticResource Btn}" Content="Отменить съёмку"
                            Command="{Binding CancelBatchCommand}"
                            IsEnabled="{Binding BatchActive}" />
                    <Button Style="{StaticResource Btn}" Content="Сохранить все монеты пакета"
                            Command="{Binding SaveBatchCommand}"
                            IsEnabled="{Binding BatchPhase}"
                            Visibility="Collapsed" />
                    <TextBlock Text="{Binding BatchStatus}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding BatchResults}" Height="140" Margin="0,6,0,0"
                              SelectedItemStyle="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding OrderNo}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ObversePct, StringFormat={}{0:0.0}%" />
                                    <TextBlock Grid.Column="2" Text="{Binding ReversePct, StringFormat={}{0:0.0}%" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Separator Margin="0,10" />
                    <TextBlock Text="Аверс" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <Image Source="{Binding ObverseImage}" Height="180" Stretch="Uniform"
                           Background="#FFEFEFEF" />
                    <TextBlock Text="Реверс" FontWeight="SemiBold" Margin="0,8,0,2" />
                    <Image Source="{Binding ReverseImage}" Height="180" Stretch="Uniform"
                           Background="#FFEFEFEF" />
                </StackPanel>
            </Border>

            <!-- ===== Center: Comparison ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Title}" Text="Сравнение" />

                    <Grid Grid.Row="1" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Текущее" FontWeight="SemiBold" />
                            <Image Source="{Binding ObverseImage}" Stretch="Uniform"
                                   Background="#FFEFEFEF" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Базовое (эталон)" FontWeight="SemiBold" />
                            <Image Source="{Binding EtalonImage}" Stretch="Uniform"
                                   Background="#FFEFEFEF" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Аверс" />
                                <TextBlock Text="{Binding ObversePct, StringFormat={}{0:0.0}%}"
                                           FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Реверс" />
                                <TextBlock Text="{Binding ReversePct, StringFormat={}{0:0.0}%}"
                                           FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Вариант" />
                                <TextBlock Text="{Binding Orientation}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource Btn}" Content="Найти похожие"
                                Command="{Binding SearchCommand}" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource Btn}" Content="Пересобрать индекс"
                                Command="{Binding RebuildIndexCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Right: Coin / Actions / Numista ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Действия" />
                        <Button Style="{StaticResource Btn}" Content="Сохранить (совпадение)"
                                Command="{Binding SaveMatchCommand}" />
                        <Button Style="{StaticResource Btn}" Content="Добавить как дубликат"
                                Command="{Binding SaveDuplicateCommand}" />
                        <Button Style="{StaticResource Btn}" Content="Добавить в другой сохранности"
                                Command="{Binding SaveVariantCommand}" />
                        <Button Style="{StaticResource Btn}" Content="Добавить как аномалию"
                                Command="{Binding SaveAnomalyCommand}" />

                        <Separator Margin="0,10" />
                        <TextBlock Style="{StaticResource Title}" Text="Numista" />
                        <TextBlock Text="Ручная ссылка" Margin="0,0,0,2" />
                        <TextBox Text="{Binding NumistaLink, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Например: https://ru.numista.com/3023" />
                        <TextBlock Text="Поиск по API" Margin="0,8,0,2" />
                        <TextBox Text="{Binding NumistaQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Например: 5 рублей 1991 СССР" />
                        <Button Style="{StaticResource Btn}" Content="Поиск"
                                Command="{Binding NumistaSearchCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
