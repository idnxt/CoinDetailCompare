<Window x:Class="CoinDetailCompare.App.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:CoinDetailCompare.App.Controls"
         xmlns:vm="clr-namespace:CoinDetailCompare.App.ViewModels"
         Title="CoinDetailCompare"
         Width="1280" Height="800"
         WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FF2B2E33" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding BackendToggleText}"
                            Command="{Binding ToggleBackendCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTip="{Binding BackendStateText}"
                            Margin="0,0,6,0" />
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding BackendIndicatorBrush}"
                             Margin="0,0,6,0" />
                    <TextBlock Text="{Binding BackendStateText}" Foreground="#FFF0F0F0"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="GPU"
                            Command="{Binding SetupGpuCommand}"
                            ToolTip="{Binding GpuSetupTitle, Source={StaticResource Strings}}"
                            Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusLanguage, Source={StaticResource Strings}}"
                               Foreground="#FFF0F0F0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="60" VerticalAlignment="Center"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="#FFF0F0F0" />
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left: Capture entry + catalog tree ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- "Open capture window"; right-click keeps manual
                         file load / swap sides available (no buttons now). -->
                    <Button Grid.Row="0" Style="{StaticResource Btn}"
                            Content="{Binding CaptureOpenCamera, Source={StaticResource Strings}}"
                            Command="{Binding OpenCameraCommand}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding CaptureLoadObverse, Source={StaticResource Strings}}"
                                          Command="{Binding LoadObverseFileCommand}" />
                                <MenuItem Header="{Binding CaptureLoadReverse, Source={StaticResource Strings}}"
                                          Command="{Binding LoadReverseFileCommand}" />
                                <MenuItem Header="{Binding CaptureSwapSides, Source={StaticResource Strings}}"
                                          Command="{Binding SwapSidesCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Separator Grid.Row="1" Margin="0,10" />

                    <!-- Catalog tree: Альбомы → Альбом → Страница → монета;
                         "Страны" is locked until references are added.
                         Refresh is automatic: on start, after a scene save and
                         when the catalog window is closed. -->
                    <TextBlock Grid.Row="2" Style="{StaticResource Title}"
                               Text="{Binding CatalogTitle, Source={StaticResource Strings}}" />

                    <!-- Double-click / Enter / right-click are wired on the
                         TreeView itself via tunneling (Preview) events and
                         resolve the node from the clicked TreeViewItem's
                         DataContext: the legacy per-item EventSetter resolved
                         to UIElement.MouseLeftButtonDownEvent (Direct
                         strategy) and never fired for clicks on the row's
                         TextBlock. -->
                    <TreeView Grid.Row="3" x:Name="CatalogTree"
                              ItemsSource="{Binding CatalogTreeRoots}"
                              Margin="0,6,0,0"
                              PreviewMouseLeftButtonDown="CatalogTree_PreviewMouseLeftButtonDown"
                              PreviewKeyDown="CatalogTree_PreviewKeyDown"
                              PreviewMouseRightButtonDown="CatalogTree_PreviewMouseRightButtonDown">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate x:Key="TreeT"
                                                      DataType="{x:Type vm:CatalogTreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF333333" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF999999" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <!-- keep the branches the user opened across RefreshCatalogTree:
                             TreeViewItem.IsExpanded <-> node.IsExpanded (stable node Key) -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded"
                                        Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemTemplate="{StaticResource TreeT}"
                                                      DataType="{x:Type vm:CatalogTreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="#FF333333" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Grid.Row="4" Margin="0,6,0,0" FontSize="11" Foreground="#FF777777"
                               Text="{Binding CatalogTreeHint, Source={StaticResource Strings}}" />
                </Grid>
            </Border>

            <!-- ===== Center: Comparison ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Title}" Text="{Binding CompareSection, Source={StaticResource Strings}}" />

                    <Grid Grid.Row="1" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CompareCurrent, Source={StaticResource Strings}}" FontWeight="SemiBold" />
                            <Grid>
                                <Image Source="{Binding CompareImage}" Stretch="Uniform" />
                                <controls:AnnotationCanvas x:Name="AnnotationCanvas"
                                                         Items="{Binding AnnotationItems}"
                                                         Tool="{Binding AnnotationTool}"
                                                         Color="{Binding AnnotationColor}"
                                                         Visibility="{Binding ShowAnnotations, Converter={StaticResource BoolToVis}}" />
                                <Image Source="{Binding HeatmapImage}" Stretch="Uniform"
                                       Opacity="0.55"
                                       Visibility="{Binding ShowHeatmap, Converter={StaticResource BoolToVis}}" />
                                <!-- Diff layer: red map of where the normalized coin
                                     differs from the etalon (from /compare). -->
                                <Image Source="{Binding DiffImage}" Stretch="Uniform"
                                       Opacity="0.75"
                                       Visibility="{Binding ShowDiff, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CompareBase, Source={StaticResource Strings}}" FontWeight="SemiBold" />
                            <Image Source="{Binding EtalonImage}" Stretch="Uniform" />
                            <!-- Etalon candidates (after "find similar"): click one to swap it in. -->
                            <TextBlock Text="{Binding CompareCandidates, Source={StaticResource Strings}}"
                                       FontWeight="SemiBold" Margin="0,8,0,2"
                                       ToolTip="{Binding CompareCandidateHint, Source={StaticResource Strings}}"
                                       Visibility="{Binding HasEtalonCandidates, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasEtalonCandidates, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding EtalonCandidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                                    Margin="0,0,0,4"
                                                    Command="{Binding DataContext.SwapEtalonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Label}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- 2-D projection of the search vectors (query vs etalons) -->
                            <TextBlock Text="{Binding CompareVector, Source={StaticResource Strings}}"
                                       FontWeight="SemiBold" Margin="0,8,0,2"
                                       ToolTip="{Binding CompareVectorHint, Source={StaticResource Strings}}"
                                       Visibility="{Binding HasVectorPoints, Converter={StaticResource BoolToVis}}" />
                            <Border Background="#FF191A1E" CornerRadius="4" Padding="2"
                                    Visibility="{Binding HasVectorPoints, Converter={StaticResource BoolToVis}}">
                                <Canvas Width="260" Height="160" HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding VectorPoints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                                      Background="Transparent">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding Fill}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                                               Foreground="#FFF0F0F0"
                                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CaptureObverse, Source={StaticResource Strings}}" />
                                <TextBlock Text="{Binding ObversePct, Converter={StaticResource Pct}}"
                                           FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CaptureReverse, Source={StaticResource Strings}}" />
                                <TextBlock Text="{Binding ReversePct, Converter={StaticResource Pct}}"
                                           FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding CompareOrientation, Source={StaticResource Strings}}" />
                                <TextBlock Text="{Binding Orientation}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Width="110" Margin="0,0,8,0"
                                      ItemsSource="{Binding AnnotationToolItems}"
                                      SelectedItem="{Binding AnnotationToolName}" />
                            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{Binding AnnotationUndo, Source={StaticResource Strings}}"
                                    Command="{Binding UndoAnnotationCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Style="{StaticResource Btn}" Content="{Binding AnnotationClear, Source={StaticResource Strings}}"
                                    Command="{Binding ClearAnnotationsCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Style="{StaticResource Btn}" Content="{Binding AnnotationSaveLayer, Source={StaticResource Strings}}"
                                    Command="{Binding SaveAnnotationsCommand}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="{Binding CompareAnnotationHint, Source={StaticResource Strings}}"
                                       TextWrapping="Wrap" Foreground="#FF888888" />
                        </Grid>
                        <Button Style="{StaticResource Btn}" Content="{Binding CompareSearch, Source={StaticResource Strings}}"
                                Command="{Binding SearchCommand}" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding CompareRebuild, Source={StaticResource Strings}}"
                                Command="{Binding RebuildIndexCommand}" HorizontalAlignment="Left" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Btn}" Content="{Binding CompareSwap, Source={StaticResource Strings}}"
                                    Command="{Binding SwapCompareCommand}" Margin="0,0,12,0" />
                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                      Content="{Binding CompareDevice, Source={StaticResource Strings}}"
                                      IsChecked="{Binding UseGpu}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Text="{Binding ComparePatches, Source={StaticResource Strings}}" />
                            <ComboBox Grid.Column="3" Width="70" VerticalAlignment="Center" Margin="0,0,12,0"
                                      ItemsSource="{Binding PatchGridItems}"
                                      SelectedItem="{Binding PatchGrid}" />
                            <CheckBox Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                      Content="{Binding CompareHeatmap, Source={StaticResource Strings}}"
                                      IsChecked="{Binding ShowHeatmap}" />
                            <CheckBox Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0"
                                      Content="{Binding CompareDiff, Source={StaticResource Strings}}"
                                      IsChecked="{Binding ShowDiff}" />
                            <CheckBox Grid.Column="6" VerticalAlignment="Center"
                                      Content="{Binding CompareLayer, Source={StaticResource Strings}}"
                                      IsChecked="{Binding ShowAnnotations}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Btn}"
                                    Content="{Binding AnomalyCheck, Source={StaticResource Strings}}"
                                    Command="{Binding RunAnomalyCommand}" Margin="0,0,12,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding AnomalyStatus}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Right: Coin / Actions / Numista ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="{Binding ActionsSection, Source={StaticResource Strings}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ActionsSaveMatch, Source={StaticResource Strings}}"
                                Command="{Binding SaveMatchCommand}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ActionsDuplicate, Source={StaticResource Strings}}"
                                Command="{Binding SaveDuplicateCommand}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ActionsVariant, Source={StaticResource Strings}}"
                                Command="{Binding SaveVariantCommand}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ActionsAnomaly, Source={StaticResource Strings}}"
                                Command="{Binding SaveAnomalyCommand}" />

                        <Separator Margin="0,10" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding NumistaSection, Source={StaticResource Strings}}" />
                        <TextBlock Text="{Binding NumistaManualLink, Source={StaticResource Strings}}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding NumistaLink, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding NumistaLinkExample, Source={StaticResource Strings}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding NumistaValidateLink, Source={StaticResource Strings}}"
                                Command="{Binding ValidateNumistaCommand}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" />
                        <TextBlock Text="{Binding NumistaSearchByApi, Source={StaticResource Strings}}" Margin="0,8,0,2" />
                        <TextBox Text="{Binding NumistaQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding NumistaSearchPlaceholder, Source={StaticResource Strings}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding NumistaSearch, Source={StaticResource Strings}}"
                                Command="{Binding NumistaSearchCommand}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" />
                        <ListView ItemsSource="{Binding NumistaResults}" SelectedItem="{Binding NumistaSelected}"
                                  Height="140" Margin="0,6,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding year}" />
                                        <TextBlock Text="{Binding country}" Foreground="#FF888888" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Style="{StaticResource Btn}" Content="{Binding NumistaApplyItem, Source={StaticResource Strings}}"
                                Command="{Binding ApplyNumistaItemCommand}" Margin="0,6,0,0" />

                        <Separator Margin="0,10" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding CoinSection, Source={StaticResource Strings}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding CoinMintYear, Source={StaticResource Strings}}" />
                                <TextBox Text="{Binding MintYear, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding CoinMint, Source={StaticResource Strings}}" Margin="0,6,0,2" />
                                <TextBox Text="{Binding Mint, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding CoinQuality, Source={StaticResource Strings}}" />
                                <ComboBox ItemsSource="{Binding QualityItems}"
                                          SelectedItem="{Binding Quality}" />
                                <TextBlock Text="{Binding CoinAnomalyDesc, Source={StaticResource Strings}}" Margin="0,6,0,2" />
                                <TextBox Text="{Binding AnomalyDesc, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="56"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource Btn}" Content="{Binding CoinSaveAttributes, Source={StaticResource Strings}}"
                                Command="{Binding SaveAttributesCommand}" HorizontalAlignment="Left" />

                        <Separator Margin="0,10" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding TypeSection, Source={StaticResource Strings}}" />
                        <TextBlock Text="{Binding TypeName, Source={StaticResource Strings}}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding TypeEditor.Name, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding TypeIssuer, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Issuer, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypePeriod, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Period, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeValue, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Value, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeCurrency, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Currency, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeDiameter, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Diameter, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding TypeYears, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Years, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeComposition, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Composition, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeMass, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Mass, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeThickness, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Thickness, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeShape, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Shape, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeTechnique, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Technique, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding TypeOrientation, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <ComboBox ItemsSource="{Binding OrientationItems}"
                                          SelectedItem="{Binding TypeEditor.Orientation}" />
                                <TextBlock Text="{Binding TypeNumistaUrl, Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.NumistaUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Btn}" Content="{Binding TypeLoadType, Source={StaticResource Strings}}"
                                    Command="{Binding LoadTypeCommand}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{Binding TypeSaveType, Source={StaticResource Strings}}"
                                    Command="{Binding SaveTypeCommand}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
