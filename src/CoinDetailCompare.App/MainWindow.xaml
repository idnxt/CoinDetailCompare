<Window x:Class="CoinDetailCompare.App.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:CoinDetailCompare.App.Controls"
         Title="CoinDetailCompare"
         Width="1280" Height="800"
         WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FF2B2E33" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding ['status.language'], Source={StaticResource Strings}}"
                               Foreground="#FFF0F0F0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="60" VerticalAlignment="Center"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="#FFF0F0F0" />
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left: Capture ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="{Binding ['capture.section'], Source={StaticResource Strings}}" />

                    <TextBlock Text="{Binding ['capture.album'], Source={StaticResource Strings}}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ['capture.page'], Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding PageNo}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ['capture.order'], Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding OrderNo}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding ['capture.rotation'], Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding Rotation}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.shoot_obverse'], Source={StaticResource Strings}}"
                            Command="{Binding ShootObverseCommand}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.shoot_reverse'], Source={StaticResource Strings}}"
                            Command="{Binding ShootReverseCommand}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.load_obverse'], Source={StaticResource Strings}}"
                            Command="{Binding LoadObverseFileCommand}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.load_reverse'], Source={StaticResource Strings}}"
                            Command="{Binding LoadReverseFileCommand}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.swap_sides'], Source={StaticResource Strings}}"
                            Command="{Binding SwapSidesCommand}" />

                    <Separator Margin="0,10" />
                    <TextBlock Style="{StaticResource Title}" Text="{Binding ['capture.batch_mode'], Source={StaticResource Strings}}" />
                    <TextBlock Text="{Binding ['capture.album'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                    <TextBox Text="{Binding BatchAlbum, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ['capture.page'], Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding BatchPage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ['capture.batch_coins'], Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding BatchCount}" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.open_camera'], Source={StaticResource Strings}}"
                            Command="{Binding OpenCameraCommand}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.start_batch'], Source={StaticResource Strings}}"
                            Command="{Binding StartBatchCommand}"
                            IsEnabled="{Binding BatchActive, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.capture_frame'], Source={StaticResource Strings}}"
                            Command="{Binding CaptureNextCommand}"
                            IsEnabled="{Binding BatchActive}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.cancel_batch'], Source={StaticResource Strings}}"
                            Command="{Binding CancelBatchCommand}"
                            IsEnabled="{Binding BatchActive}" />
                    <Button Style="{StaticResource Btn}" Content="{Binding ['capture.save_all'], Source={StaticResource Strings}}"
                            Command="{Binding SaveBatchCommand}"
                            Visibility="Collapsed" />
                    <TextBlock Text="{Binding BatchStatus}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding BatchResults}" Height="140" Margin="0,6,0,0"
                              SelectedItemStyle="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding OrderNo}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ObversePct, StringFormat={}{0:0.0}%" />
                                    <TextBlock Grid.Column="2" Text="{Binding ReversePct, StringFormat={}{0:0.0}%" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Separator Margin="0,10" />
                    <TextBlock Text="{Binding ['capture.obverse'], Source={StaticResource Strings}}" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <Image Source="{Binding ObverseImage}" Height="180" Stretch="Uniform"
                           Background="#FFEFEFEF" />
                    <TextBlock Text="{Binding ['capture.reverse'], Source={StaticResource Strings}}" FontWeight="SemiBold" Margin="0,8,0,2" />
                    <Image Source="{Binding ReverseImage}" Height="180" Stretch="Uniform"
                           Background="#FFEFEFEF" />
                </StackPanel>
            </Border>

            <!-- ===== Center: Comparison ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Title}" Text="{Binding ['compare.section'], Source={StaticResource Strings}}" />

                    <Grid Grid.Row="1" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ['compare.current'], Source={StaticResource Strings}}" FontWeight="SemiBold" />
                            <Grid>
                                <Image Source="{Binding ObverseImage}" Stretch="Uniform"
                                       Background="#FFEFEFEF" />
                                <controls:AnnotationCanvas x:Name="AnnotationCanvas"
                                                         Items="{Binding AnnotationItems}"
                                                         Tool="{Binding AnnotationTool}"
                                                         Color="{Binding AnnotationColor}" />
                                <Image Source="{Binding HeatmapImage}" Stretch="Uniform"
                                       Opacity="0.55" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ['compare.base'], Source={StaticResource Strings}}" FontWeight="SemiBold" />
                            <Image Source="{Binding EtalonImage}" Stretch="Uniform"
                                   Background="#FFEFEFEF" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ['capture.obverse'], Source={StaticResource Strings}}" />
                                <TextBlock Text="{Binding ObversePct, StringFormat={}{0:0.0}%}"
                                           FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ['capture.reverse'], Source={StaticResource Strings}}" />
                                <TextBlock Text="{Binding ReversePct, StringFormat={}{0:0.0}%}"
                                           FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding ['compare.orientation'], Source={StaticResource Strings}}" />
                                <TextBlock Text="{Binding Orientation}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Width="110" Margin="0,0,8,0"
                                      ItemsSource="{Binding AnnotationToolItems}"
                                      SelectedItem="{Binding AnnotationToolName}" />
                            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{Binding ['annotation.undo'], Source={StaticResource Strings}}"
                                    Command="{Binding UndoAnnotationCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Style="{StaticResource Btn}" Content="{Binding ['annotation.clear'], Source={StaticResource Strings}}"
                                    Command="{Binding ClearAnnotationsCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Style="{StaticResource Btn}" Content="{Binding ['annotation.save_layer'], Source={StaticResource Strings}}"
                                    Command="{Binding SaveAnnotationsCommand}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="{Binding ['compare.annotation_hint'], Source={StaticResource Strings}}"
                                       TextWrapping="Wrap" Foreground="#FF888888" />
                        </Grid>
                        <Button Style="{StaticResource Btn}" Content="{Binding ['compare.search'], Source={StaticResource Strings}}"
                                Command="{Binding SearchCommand}" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ['compare.rebuild'], Source={StaticResource Strings}}"
                                Command="{Binding RebuildIndexCommand}" HorizontalAlignment="Left" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Btn}"
                                    Content="{Binding ['anomaly.check'], Source={StaticResource Strings}}"
                                    Command="{Binding RunAnomalyCommand}" Margin="0,0,12,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding AnomalyStatus}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Right: Coin / Actions / Numista ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="{Binding ['actions.section'], Source={StaticResource Strings}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ['actions.save_match'], Source={StaticResource Strings}}"
                                Command="{Binding SaveMatchCommand}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ['actions.duplicate'], Source={StaticResource Strings}}"
                                Command="{Binding SaveDuplicateCommand}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ['actions.variant'], Source={StaticResource Strings}}"
                                Command="{Binding SaveVariantCommand}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ['actions.anomaly'], Source={StaticResource Strings}}"
                                Command="{Binding SaveAnomalyCommand}" />

                        <Separator Margin="0,10" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding ['numista.section'], Source={StaticResource Strings}}" />
                        <TextBlock Text="{Binding ['numista.manual_link'], Source={StaticResource Strings}}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding NumistaLink, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding ['numista.link_example'], Source={StaticResource Strings}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ['numista.validate_link'], Source={StaticResource Strings}}"
                                Command="{Binding ValidateNumistaCommand}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ['numista.search_by_api'], Source={StaticResource Strings}}" Margin="0,8,0,2" />
                        <TextBox Text="{Binding NumistaQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding ['numista.search_placeholder'], Source={StaticResource Strings}}" />
                        <Button Style="{StaticResource Btn}" Content="{Binding ['numista.search'], Source={StaticResource Strings}}"
                                Command="{Binding NumistaSearchCommand}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" />
                        <ListView ItemsSource="{Binding NumistaResults}" SelectedItem="{Binding NumistaSelected}"
                                  Height="140" Margin="0,6,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding year}" />
                                        <TextBlock Text="{Binding country}" Foreground="#FF888888" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Style="{StaticResource Btn}" Content="{Binding ['numista.apply_item'], Source={StaticResource Strings}}"
                                Command="{Binding ApplyNumistaItemCommand}" Margin="0,6,0,0" />

                        <Separator Margin="0,10" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding ['coin.section'], Source={StaticResource Strings}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding ['coin.mint_year'], Source={StaticResource Strings}}" />
                                <TextBox Text="{Binding MintYear, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['coin.mint'], Source={StaticResource Strings}}" Margin="0,6,0,2" />
                                <TextBox Text="{Binding Mint, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ['coin.quality'], Source={StaticResource Strings}}" />
                                <ComboBox ItemsSource="{Binding QualityItems}"
                                          SelectedItem="{Binding Quality}" />
                                <TextBlock Text="{Binding ['coin.anomaly_desc'], Source={StaticResource Strings}}" Margin="0,6,0,2" />
                                <TextBox Text="{Binding AnomalyDesc, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="56"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource Btn}" Content="{Binding ['coin.save_attributes'], Source={StaticResource Strings}}"
                                Command="{Binding SaveAttributesCommand}" HorizontalAlignment="Left" />

                        <Separator Margin="0,10" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding ['type.section'], Source={StaticResource Strings}}" />
                        <TextBlock Text="{Binding ['type.name'], Source={StaticResource Strings}}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding TypeEditor.Name, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding ['type.issuer'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Issuer, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.period'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Period, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.value'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Value, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.currency'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Currency, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.diameter'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Diameter, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ['type.years'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Years, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.composition'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Composition, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.mass'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Mass, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.thickness'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Thickness, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.shape'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Shape, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.technique'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.Technique, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding ['type.orientation'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <ComboBox ItemsSource="{Binding OrientationItems}"
                                          SelectedItem="{Binding TypeEditor.Orientation}" />
                                <TextBlock Text="{Binding ['type.numista_url'], Source={StaticResource Strings}}" Margin="0,4,0,2" />
                                <TextBox Text="{Binding TypeEditor.NumistaUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Btn}" Content="{Binding ['type.load_type'], Source={StaticResource Strings}}"
                                    Command="{Binding LoadTypeCommand}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{Binding ['type.save_type'], Source={StaticResource Strings}}"
                                    Command="{Binding SaveTypeCommand}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
