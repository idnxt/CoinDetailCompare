<Window x:Class="CoinDetailCompare.App.Views.CoinCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CoinDetailCompare.App.Controls"
        Title="Coin card"
        Width="1080" Height="858"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: coin layers (same composition as during photo) ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <StackPanel>
                <!-- layer control, 3 columns:
                     row 1: v Тепловая карта | v Слой разницы | v Фото эталона
                     row 2: (прозрачность ТК) | (прозрачность СР) | (прозрачность ФЭ)
                     row 3: (угол) | (масштаб) | X Y -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,6"
                              Content="{Binding CompareHeatmap, Source={StaticResource Strings}}"
                              IsChecked="{Binding ShowHeatmap}" />
                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"
                              Content="{Binding CardLayerDiff, Source={StaticResource Strings}}"
                              IsChecked="{Binding ShowDiffLayer}" />
                    <CheckBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,6"
                              Content="{Binding CardLayerEtalonPhoto, Source={StaticResource Strings}}"
                              IsChecked="{Binding ShowEtalonPhoto}" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,6">
                        <Slider x:Name="HeatmapOpacitySlider" Width="60"
                                Minimum="0" Maximum="100" VerticalAlignment="Center"
                                Value="{Binding HeatmapOpacity}"
                                ToolTip="{Binding CardOpacity, Source={StaticResource Strings}}" />
                        <TextBlock Text="{Binding HeatmapOpacity}" VerticalAlignment="Center"
                                   Margin="3,0,0,0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,6">
                        <Button x:Name="DiffColorBtn" Width="22" Height="14" Padding="0"
                                BorderBrush="#FF555555" BorderThickness="1"
                                ToolTip="{Binding CardOpacity, Source={StaticResource Strings}}"
                                Click="OnPickDiffColor" />
                        <Slider x:Name="DiffOpacitySlider" Width="60" Margin="4,0,0,0"
                                Minimum="0" Maximum="100" VerticalAlignment="Center"
                                Value="{Binding DiffOpacity}"
                                ToolTip="{Binding CardOpacity, Source={StaticResource Strings}}" />
                        <TextBlock Text="{Binding DiffOpacity}" VerticalAlignment="Center"
                                   Margin="3,0,0,0" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <Slider x:Name="EtalonPhotoOpacitySlider" Width="60"
                                Minimum="0" Maximum="100" VerticalAlignment="Center"
                                Value="{Binding EtalonPhotoOpacity}"
                                ToolTip="{Binding CardOpacity, Source={StaticResource Strings}}" />
                        <TextBlock Text="{Binding EtalonPhotoOpacity}" VerticalAlignment="Center"
                                   Margin="3,0,0,0" FontSize="11" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CardAngle, Source={StaticResource Strings}}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider x:Name="EtalonPhotoAngleSlider" Width="56" Minimum="-180" Maximum="180"
                                Value="{Binding EtalonPhotoAngle}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="AngleBox" Width="68" Margin="3,0,0,0"
                                                Value="{Binding EtalonPhotoAngle, Mode=TwoWay}"
                                                Minimum="-180" Maximum="180" Step="0.01"
                                                VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CardScale, Source={StaticResource Strings}}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider x:Name="EtalonPhotoScaleSlider" Width="56" Minimum="80" Maximum="120"
                                Value="{Binding EtalonPhotoScalePct}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="ScaleBox" Width="68" Margin="3,0,0,0"
                                                Value="{Binding EtalonPhotoScalePct, Mode=TwoWay}"
                                                Minimum="80" Maximum="120" Step="0.01"
                                                VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- manual XY shift (px, -100..100, base 0, 0.01 precision) -->
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider x:Name="EtalonPhotoXSlider" Width="50" Minimum="-100" Maximum="100"
                                Value="{Binding EtalonPhotoOffsetX}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="XBox" Width="66" Margin="3,0,0,0"
                                                Value="{Binding EtalonPhotoOffsetX, Mode=TwoWay}"
                                                Minimum="-100" Maximum="100" Step="0.01"
                                                VerticalAlignment="Center" />
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="6,0,4,0" />
                        <Slider x:Name="EtalonPhotoYSlider" Width="50" Minimum="-100" Maximum="100"
                                Value="{Binding EtalonPhotoOffsetY}" VerticalAlignment="Center" />
                        <controls:NumericUpDown x:Name="YBox" Width="66" Margin="3,0,0,0"
                                                Value="{Binding EtalonPhotoOffsetY, Mode=TwoWay}"
                                                Minimum="-100" Maximum="100" Step="0.01"
                                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- base photo + overlays -->
                <Grid>
                    <Image Source="{Binding BaseImage}" Stretch="Uniform" />
                    <Image Source="{Binding HeatmapImage}" Stretch="Uniform"
                           Opacity="{Binding HeatmapOpacity, Converter={StaticResource Opacity01}}"
                           Visibility="{Binding ShowHeatmap, Converter={StaticResource BoolToVis}}" />
                    <!-- diff layer (etalon/current): direct |a-b| of the raw crops;
                         follows the etalon photo's rotation/zoom (same transform) -->
                    <Image x:Name="DiffOverlay" Source="{Binding DiffImage}" Stretch="Uniform"
                           Opacity="{Binding DiffOpacity, Converter={StaticResource Opacity01}}"
                           Visibility="{Binding ShowDiffLayer, Converter={StaticResource BoolToVis}}"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding EtalonPhotoScale}"
                                                ScaleY="{Binding EtalonPhotoScale}" />
                                <RotateTransform Angle="{Binding EtalonPhotoAngle}" />
                                <TranslateTransform X="{Binding EtalonPhotoOffsetX}"
                                                   Y="{Binding EtalonPhotoOffsetY}" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <!-- manual etalon photo: drag = shift along X/Y (±100 px), wheel = zoom -->
                    <Image x:Name="EtalonPhotoOverlay" Source="{Binding EtalonPhotoImage}"
                           Stretch="Uniform"
                           Opacity="{Binding EtalonPhotoOpacity, Converter={StaticResource Opacity01}}"
                           Visibility="{Binding ShowEtalonPhoto, Converter={StaticResource BoolToVis}}"
                           RenderTransformOrigin="0.5,0.5"
                           Cursor="SizeAll"
                           Focusable="True"
                           MouseLeftButtonDown="OnEtalonPhotoMouseDown"
                           MouseMove="OnEtalonPhotoMouseMove"
                           MouseLeftButtonUp="OnEtalonPhotoMouseUp"
                           MouseWheel="OnEtalonPhotoWheel"
                           PreviewKeyDown="OnEtalonPhotoKeyDown">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding EtalonPhotoScale}"
                                                ScaleY="{Binding EtalonPhotoScale}" />
                                <RotateTransform Angle="{Binding EtalonPhotoAngle}" />
                                <TranslateTransform X="{Binding EtalonPhotoOffsetX}"
                                                   Y="{Binding EtalonPhotoOffsetY}" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <controls:AnnotationCanvas Items="{Binding AnnotationItems}"
                                               Tool="{Binding AnnotationTool}"
                                               Color="#FFFF3030"
                                               Visibility="{Binding ShowAnnotations, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <TextBlock Text="{Binding CardEtalonPhotoHint, Source={StaticResource Strings}}"
                           Margin="0,6,0,0" FontSize="11" Foreground="#FF888888"
                           Visibility="{Binding HasEffectiveEtalon, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding AnomalyStatus}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <Button Style="{StaticResource Btn}" Margin="0,8,0,0"
                        Content="{Binding AnomalyCheck, Source={StaticResource Strings}}"
                        Command="{Binding RunAnomalyCommand}"
                        IsEnabled="{Binding Blocked, Converter={StaticResource InverseBool}}" />
                <Button Style="{StaticResource Btn}"
                        Content="{Binding CardRunCompare, Source={StaticResource Strings}}"
                        Command="{Binding RunCompareCommand}"
                        IsEnabled="{Binding Blocked, Converter={StaticResource InverseBool}}" />
                <Button Style="{StaticResource Btn}"
                        Content="{Binding CardRegenVector, Source={StaticResource Strings}}"
                        Command="{Binding RegenerateVectorCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Style="{StaticResource Btn}"
                        Content="{Binding CardReset, Source={StaticResource Strings}}"
                        Command="{Binding ResetEtalonPhotoCommand}"
                        IsEnabled="{Binding HasEffectiveEtalon}" />
            </StackPanel>
        </Border>

        <!-- ===== Right: card attributes ===== -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- header row: title + side-switch button ("Аверс"/"Реверс") -->
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0,0,0,8"
                                Padding="10,3"
                                Content="{Binding SwapSideLabel}"
                                Command="{Binding SwapSideCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding Header}" />
                    </DockPanel>
                    <TextBlock Text="{Binding EtalonLabel}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding KindLabel, Source={StaticResource Strings}}" Margin="0,6,0,2" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton GroupName="CardKind" VerticalContentAlignment="Center"
                                     Content="{Binding KindEtalon, Source={StaticResource Strings}}"
                                     IsChecked="{Binding IsDuplicate, Converter={StaticResource InverseBool}}" />
                        <RadioButton GroupName="CardKind" VerticalContentAlignment="Center" Margin="12,0,0,0"
                                     Content="{Binding KindDuplicate, Source={StaticResource Strings}}"
                                     IsChecked="{Binding IsDuplicate}" />
                    </StackPanel>
                    <CheckBox Content="{Binding KindAnomaly, Source={StaticResource Strings}}"
                              IsChecked="{Binding IsAnomaly}" Margin="0,0,0,0" />

                    <TextBlock Text="{Binding TypeName, Source={StaticResource Strings}}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CaptureAlbum, Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CapturePage, Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding PageNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding CaptureOrder, Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CatalogYear, Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding MintYear, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding CoinMint, Source={StaticResource Strings}}" />
                            <TextBox Text="{Binding Mint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding CoinQuality, Source={StaticResource Strings}}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding CoinAnomalyDesc, Source={StaticResource Strings}}" Margin="0,6,0,2" />
                    <TextBox Text="{Binding AnomalyDesc, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="56"
                             VerticalScrollBarVisibility="Auto" />

                    <Button Style="{StaticResource Btn}" Margin="0,12,0,0"
                            Content="{Binding CardSave, Source={StaticResource Strings}}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <!-- annotation tools -->
                    <CheckBox Margin="0,16,0,8" VerticalContentAlignment="Center"
                              Content="{Binding AnnotationSaveLayer, Source={StaticResource Strings}}"
                              IsChecked="{Binding ShowAnnotations}" />
                    <ComboBox ItemsSource="{Binding AnnotationToolItems}"
                              SelectedItem="{Binding AnnotationToolName}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0"
                                Content="{Binding AnnotationUndo, Source={StaticResource Strings}}"
                                Command="{Binding UndoAnnotationCommand}" />
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0"
                                Content="{Binding AnnotationClear, Source={StaticResource Strings}}"
                                Command="{Binding ClearAnnotationsCommand}" />
                        <Button Style="{StaticResource Btn}"
                                Content="{Binding AnnotationSaveLayer, Source={StaticResource Strings}}"
                                Command="{Binding SaveAnnotationsCommand}" />
                    </StackPanel>

                    <!-- find similar / pick the etalon for this coin -->
                    <TextBlock Style="{StaticResource Title}" Margin="0,16,0,8"
                               Text="{Binding CardSimilar, Source={StaticResource Strings}}" />
                    <Button Style="{StaticResource Btn}"
                            Content="{Binding CardFindSimilar, Source={StaticResource Strings}}"
                            Command="{Binding FindSimilarCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <ListBox ItemsSource="{Binding SimilarCandidates}"
                             SelectedItem="{Binding SelectedSimilar}"
                             Margin="0,6,0,6" MaxHeight="170" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0"
                                Content="{Binding CardPickEtalon, Source={StaticResource Strings}}"
                                Command="{Binding PickEtalonCommand}"
                                IsEnabled="{Binding CanPickEtalon}" />
                        <Button Style="{StaticResource Btn}"
                                Content="{Binding CardResetEtalon, Source={StaticResource Strings}}"
                                Command="{Binding ResetEtalonCommand}"
                                IsEnabled="{Binding HasEffectiveEtalon}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="#FF555555" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
