<Window x:Class="CoinDetailCompare.App.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding CaptureWindowTitle, Source={StaticResource Strings}}"
        Width="1040" Height="585"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1F22">
    <DockPanel>
        <!-- Header row: album / page / coin number + expand button -->
        <Border DockPanel.Dock="Top" Background="#FF2B2E33" CornerRadius="4"
                Padding="10,6" Margin="8,0,8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ExpandButton" Click="OnToggleMaximize"
                        Padding="14,4" FontSize="13" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="#FFB0B0B0"
                           Text="{Binding CaptureHotkeysHint, Source={StaticResource Strings}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding CaptureAlbum, Source={StaticResource Strings}}"
                                   Foreground="#FFB0B0B0" />
                        <TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding CapturePage, Source={StaticResource Strings}}"
                                   Foreground="#FFB0B0B0" />
                        <TextBox Text="{Binding PageNo}" Width="60" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding CaptureOrder, Source={StaticResource Strings}}"
                                   Foreground="#FFB0B0B0" />
                        <TextBox Text="{Binding OrderNo}" Width="60" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 16:9 body. Left block is 9:9 (square viewfinder), right block is 7:9. -->
        <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: live viewfinder (9:9) ===== -->
        <Grid Grid.Column="0" Background="#FF000000">
            <!-- Square stage (1000x1000 logical), scaled uniformly to fit the
                 cell and centered. The live image and the template circle
                 live in the SAME coordinate space, so the circle is always
                 exactly over the crop center (PumpFrame center-crops the
                 frame to a square). ClipToBounds keeps the image inside the
                 stage so it never bleeds into the right panel. -->
            <Viewbox IsHitTestVisible="False">
                <Grid Width="1000" Height="1000" ClipToBounds="True">
                    <Image x:Name="LiveImage" Stretch="Fill" />
                    <!-- Green coin template circle: 95% of the square stage. -->
                    <Ellipse Margin="2.5"
                             Stroke="#FF00E676" StrokeThickness="6"
                             Fill="#3300E676" />
                </Grid>
            </Viewbox>
        </Grid>

        <!-- ===== Right (7:9): previews on top, buttons on the bottom ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>

            <!-- Two preview panes: obverse / reverse -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding CaptureObverse, Source={StaticResource Strings}}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Image Source="{Binding ObverseImage}" Stretch="Uniform" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding CaptureReverse, Source={StaticResource Strings}}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Image Source="{Binding ReverseImage}" Stretch="Uniform" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Four buttons: shoot obverse (1), shoot reverse (2),
                 save + next coin (~), close (Esc) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="OnShootObverse"
                        Content="{Binding CaptureShootObverseKey, Source={StaticResource Strings}}"
                        FontSize="15" Padding="6,10" Margin="0,0,4,0" />
                <Button Grid.Column="1" Click="OnShootReverse"
                        Content="{Binding CaptureShootReverseKey, Source={StaticResource Strings}}"
                        FontSize="15" Padding="6,10" Margin="4,0,4,0" />
                <Button Grid.Column="2" Click="OnSaveNext"
                        Content="{Binding CaptureNext, Source={StaticResource Strings}}"
                        FontSize="15" Padding="6,10" Margin="4,0,4,0" />
                <Button Grid.Column="3" Click="OnClose"
                        Content="{Binding CaptureClose, Source={StaticResource Strings}}"
                        FontSize="15" Padding="6,10" Margin="4,0,0,0" />
            </Grid>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
